# Local-only credentials; copy to .env and never commit .env.
TYPESAFE_API_KEY=

# Optional public portfolio upload. Keep disabled until the Vercel endpoint exists.
JEV_CLOUD_UPLOAD=0
JEV_CLOUD_INGEST_URL=https://your-vercel-project.vercel.app/api/ingest
JEV_CLOUD_INGEST_TOKEN=

# Anonymous community telemetry is on by default; set to 0 to opt out.
# JEV_TELEMETRY=0